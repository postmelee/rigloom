{
  "name": "rigloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "wasm": "wasm-pack build crates/rigloom-wasm --target web --out-dir ../../src/wasm --release --locked",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/fixtures.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html",
    "test:compatibility": "playwright test tests/compatibility.spec.ts",
    "test:compatibility:godot": "node scripts/compatibility/godot.mjs",
    "test:compatibility:drum": "node scripts/compatibility/drum-local.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
